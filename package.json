{
  "name": "stunts-reimagined",
  "version": "0.1.1",
  "description": "A modern, offline stunt racing playground for Windows 11",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "coverage": "c8 --all --include=src/** --include=desktop/** --include=vite.config.mjs --100 --reporter=text --reporter=html --reporter=json-summary node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win portable --x64",
    "test:ui": "npm run build && node tests/browser.mjs",
    "test:desktop": "npm run build && node tests/desktop-smoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "build": {
    "appId": "org.jrblaze.stuntsreimagined",
    "productName": "Stunts Reimagined",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Stunts-Reimagined-${version}-Windows.exe"
    }
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "c8": "^12.0.0",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "vite": "^7.3.7"
  }
}
